  <!-- Client-side Interactive Controls (Theme, Language, Experience Tabs, Copy Email) -->
  <script is:inline>
    (function () {
      const root = document.documentElement;
      const themeBtn = document.getElementById('theme-toggle');
      const iconSun = document.getElementById('icon-sun');
      const iconMoon = document.getElementById('icon-moon');
      const langBtn = document.getElementById('lang-toggle');

      function syncThemeIcons() {
        const currentTheme = root.getAttribute('data-theme') || 'dark';
        if (currentTheme === 'light') {
          iconSun?.classList.add('hidden');
          iconMoon?.classList.remove('hidden');
        } else {
          iconSun?.classList.remove('hidden');
          iconMoon?.classList.add('hidden');
        }
      }

      syncThemeIcons();

      themeBtn?.addEventListener('click', () => {
        const nextTheme = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', nextTheme);
        try {
          localStorage.setItem('tg-theme', nextTheme);
        } catch (e) {}
        syncThemeIcons();
      });

      langBtn?.addEventListener('click', () => {
        const nextLang = root.getAttribute('data-lang') === 'en' ? 'id' : 'en';
        root.setAttribute('data-lang', nextLang);
        root.setAttribute('lang', nextLang);
        try {
          localStorage.setItem('tg-lang', nextLang);
        } catch (e) {}
      });

      // Experience Dual-Track Tabs
      const tabButtons = document.querySelectorAll('.exp-tab-btn');
      const panelCore = document.getElementById('panel-core');
      const panelMentor = document.getElementById('panel-mentor');

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-exp-tab');
          tabButtons.forEach((b) => {
            const active = b.getAttribute('data-exp-tab') === target;
            b.setAttribute('aria-selected', active ? 'true' : 'false');
            if (active) {
              b.classList.add('bg-[var(--accent-primary)]', 'text-slate-950');
              b.classList.remove('text-[var(--text-secondary)]');
            } else {
              b.classList.remove('bg-[var(--accent-primary)]', 'text-slate-950');
              b.classList.add('text-[var(--text-secondary)]');
            }
          });

          if (target === 'mentor') {
            panelCore?.classList.add('hidden');
            panelMentor?.classList.remove('hidden');
          } else {
            panelMentor?.classList.add('hidden');
            panelCore?.classList.remove('hidden');
          }
        });
      });

      // Copy Email Buttons
      const copyButtons = document.querySelectorAll('.copy-email-btn');
      copyButtons.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const email = btn.getAttribute('data-copy-email') || 'taqiyyaghazi@gmail.com';
          const defaultLabel = btn.querySelector('.copy-label-default');
          const successLabel = btn.querySelector('.copy-label-success');
          try {
            await navigator.clipboard.writeText(email);
            defaultLabel?.classList.add('hidden');
            successLabel?.classList.remove('hidden');
            setTimeout(() => {
              successLabel?.classList.add('hidden');
              defaultLabel?.classList.remove('hidden');
            }, 2200);
          } catch (e) {
            window.location.href = 'mailto:' + email;
          }
        });
      });
    })();
  </script>
