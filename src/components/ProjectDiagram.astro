---
interface Props {
  type: 'uangku' | 'uilib' | 'tiketmart' | 'llama' | 'forum' | 'chatbot';
}

const { type } = Astro.props;
---

<div class="relative w-full h-44 rounded-xl overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-secondary)] flex items-center justify-center p-4 select-none">
  <div class="absolute inset-0 opacity-35 pointer-events-none" style="background-image: radial-gradient(circle at 50% 0%, var(--glow-color), transparent 70%);"></div>

  {type === 'uangku' && (
    <svg viewBox="0 0 360 130" class="w-full h-full max-w-[340px]" fill="none" aria-hidden="true">
      <!-- Receipt OCR Node -->
      <rect x="10" y="26" width="88" height="78" rx="10" fill="var(--bg-card)" stroke="var(--border-accent)" stroke-width="1.5" />
      <text x="54" y="52" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[10px] font-semibold">GEMINI AI</text>
      <text x="54" y="68" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[9px]">Receipt OCR</text>
      <text x="54" y="83" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">NLP Parser</text>

      <!-- Connector 1 -->
      <path d="M98 65H132" stroke="var(--accent-primary)" stroke-width="1.5" stroke-dasharray="3 3" />
      <circle cx="115" cy="65" r="3" fill="var(--accent-primary)" />

      <!-- Daily Breath Engine Core -->
      <rect x="132" y="16" width="104" height="98" rx="12" fill="var(--accent-surface)" stroke="var(--accent-primary)" stroke-width="1.75" />
      <text x="184" y="42" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[9px] font-bold">DAILY BREATH</text>
      <text x="184" y="60" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[11px] font-bold">Budget / Days</text>
      <rect x="146" y="72" width="76" height="6" rx="3" fill="var(--border-subtle)" />
      <rect x="146" y="72" width="54" height="6" rx="3" fill="var(--accent-primary)" />
      <text x="184" y="96" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Vertical Slice</text>

      <!-- Connector 2 -->
      <path d="M236 65H268" stroke="var(--accent-secondary)" stroke-width="1.5" stroke-dasharray="3 3" />
      <circle cx="252" cy="65" r="3" fill="var(--accent-secondary)" />

      <!-- Local-first + Sync -->
      <rect x="268" y="26" width="82" height="78" rx="10" fill="var(--bg-card)" stroke="var(--border-subtle)" stroke-width="1.5" />
      <text x="309" y="52" text-anchor="middle" fill="var(--accent-secondary)" class="font-mono-code text-[10px] font-semibold">DRIFT DB</text>
      <text x="309" y="68" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[9px]">SQLite Local</text>
      <text x="309" y="83" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">+ Firebase Sync</text>
    </svg>
  )}

  {type === 'uilib' && (
    <svg viewBox="0 0 360 130" class="w-full h-full max-w-[340px]" fill="none" aria-hidden="true">
      <!-- Design Tokens -->
      <rect x="10" y="24" width="86" height="82" rx="10" fill="var(--bg-card)" stroke="var(--border-subtle)" stroke-width="1.5" />
      <circle cx="30" cy="46" r="6" fill="#2DD4BF" />
      <circle cx="48" cy="46" r="6" fill="#38BDF8" />
      <circle cx="66" cy="46" r="6" fill="#818CF8" />
      <text x="53" y="72" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[9px] font-semibold">TOKENS</text>
      <text x="53" y="88" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Tailwind CSS</text>

      <path d="M96 65H128" stroke="var(--accent-primary)" stroke-width="1.5" />

      <!-- CVA + React 19 Core -->
      <rect x="128" y="18" width="104" height="94" rx="12" fill="var(--accent-surface)" stroke="var(--accent-primary)" stroke-width="1.75" />
      <text x="180" y="43" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[9px] font-bold">REACT 19 + CVA</text>
      <rect x="144" y="54" width="72" height="20" rx="5" fill="var(--bg-card)" stroke="var(--border-accent)" />
      <text x="180" y="67" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[8.5px]">&lt;Button /&gt;</text>
      <text x="180" y="94" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Type-Safe Variants</text>

      <path d="M232 65H264" stroke="var(--accent-secondary)" stroke-width="1.5" />

      <!-- Storybook 8 Output -->
      <rect x="264" y="24" width="86" height="82" rx="10" fill="var(--bg-card)" stroke="var(--border-accent)" stroke-width="1.5" />
      <text x="307" y="50" text-anchor="middle" fill="var(--accent-secondary)" class="font-mono-code text-[9.5px] font-bold">STORYBOOK 8</text>
      <text x="307" y="68" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[10px] font-bold">3x Faster</text>
      <text x="307" y="84" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">100% UI Parity</text>
    </svg>
  )}

  {type === 'tiketmart' && (
    <svg viewBox="0 0 360 130" class="w-full h-full max-w-[340px]" fill="none" aria-hidden="true">
      <!-- Redis Flash-Sale Gate -->
      <rect x="10" y="26" width="86" height="78" rx="10" fill="var(--bg-card)" stroke="var(--border-accent)" stroke-width="1.5" />
      <text x="53" y="50" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[9.5px] font-bold">REDIS CACHE</text>
      <text x="53" y="67" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[8px]">Atomic Lock</text>
      <text x="53" y="83" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Flash-Sale Guard</text>

      <path d="M96 65H128" stroke="var(--accent-primary)" stroke-width="1.5" stroke-dasharray="3 3" />

      <!-- NestJS DDD Core -->
      <rect x="128" y="18" width="104" height="94" rx="12" fill="var(--accent-surface)" stroke="var(--accent-primary)" stroke-width="1.75" />
      <text x="180" y="42" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[9.5px] font-bold">NESTJS + DDD</text>
      <text x="180" y="61" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[8.5px]">Domain Aggregate</text>
      <text x="180" y="77" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Order &amp; Inventory</text>
      <text x="180" y="95" text-anchor="middle" fill="var(--accent-secondary)" class="font-mono-code text-[8px]">PostgreSQL ACID</text>

      <path d="M232 65H264" stroke="var(--accent-secondary)" stroke-width="1.5" stroke-dasharray="3 3" />

      <!-- Xendit Gateway -->
      <rect x="264" y="26" width="86" height="78" rx="10" fill="var(--bg-card)" stroke="var(--border-subtle)" stroke-width="1.5" />
      <text x="307" y="50" text-anchor="middle" fill="var(--accent-secondary)" class="font-mono-code text-[9.5px] font-bold">XENDIT API</text>
      <text x="307" y="67" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[8.5px]">Webhook Sync</text>
      <text x="307" y="83" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Instant E-Ticket</text>
    </svg>
  )}

  {type === 'llama' && (
    <svg viewBox="0 0 360 130" class="w-full h-full max-w-[340px]" fill="none" aria-hidden="true">
      <!-- Vector RAG -->
      <rect x="10" y="26" width="86" height="78" rx="10" fill="var(--bg-card)" stroke="var(--border-subtle)" stroke-width="1.5" />
      <text x="53" y="50" text-anchor="middle" fill="var(--accent-secondary)" class="font-mono-code text-[9.5px] font-bold">VECTOR RAG</text>
      <text x="53" y="67" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[8.5px]">LangChain</text>
      <text x="53" y="83" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Dense Retrieval</text>

      <path d="M96 65H128" stroke="var(--accent-primary)" stroke-width="1.5" />

      <!-- LLaMA 3.1 + QLoRA -->
      <rect x="128" y="18" width="104" height="94" rx="12" fill="var(--accent-surface)" stroke="var(--accent-primary)" stroke-width="1.75" />
      <text x="180" y="42" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[9.5px] font-bold">LLaMA 3.1</text>
      <text x="180" y="61" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[9.5px] font-semibold">LoRA / QLoRA</text>
      <text x="180" y="78" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Adapter Weights</text>
      <text x="180" y="95" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[8px]">PyTorch + HF</text>

      <path d="M232 65H264" stroke="var(--accent-secondary)" stroke-width="1.5" />

      <!-- GRPO Alignment -->
      <rect x="264" y="26" width="86" height="78" rx="10" fill="var(--bg-card)" stroke="var(--border-accent)" stroke-width="1.5" />
      <text x="307" y="50" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[9.5px] font-bold">GRPO POLICY</text>
      <text x="307" y="67" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[8.5px]">Reward Tuning</text>
      <text x="307" y="83" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Aligned Output</text>
    </svg>
  )}

  {type === 'forum' && (
    <svg viewBox="0 0 360 130" class="w-full h-full max-w-[340px]" fill="none" aria-hidden="true">
      <!-- React + Redux Store -->
      <rect x="10" y="26" width="88" height="78" rx="10" fill="var(--bg-card)" stroke="var(--border-subtle)" stroke-width="1.5" />
      <text x="54" y="50" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[9.5px] font-bold">REDUX STORE</text>
      <text x="54" y="67" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[8.5px]">Async Thunks</text>
      <text x="54" y="83" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Votes &amp; Threads</text>

      <path d="M98 65H130" stroke="var(--accent-primary)" stroke-width="1.5" />

      <!-- Jest + Cypress Quality Gate -->
      <rect x="130" y="18" width="102" height="94" rx="12" fill="var(--accent-surface)" stroke="var(--accent-primary)" stroke-width="1.75" />
      <text x="181" y="42" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[9.5px] font-bold">QUALITY GATE</text>
      <text x="181" y="61" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[9px]">Jest Unit Tests</text>
      <text x="181" y="78" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[9px]">Cypress E2E</text>
      <text x="181" y="95" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">100% Automated</text>

      <path d="M232 65H264" stroke="var(--accent-secondary)" stroke-width="1.5" />

      <!-- GitHub Actions -> Vercel -->
      <rect x="264" y="26" width="86" height="78" rx="10" fill="var(--bg-card)" stroke="var(--border-accent)" stroke-width="1.5" />
      <text x="307" y="50" text-anchor="middle" fill="var(--accent-secondary)" class="font-mono-code text-[9.5px] font-bold">CI/CD PIPELINE</text>
      <text x="307" y="67" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[8.5px]">GitHub Actions</text>
      <text x="307" y="83" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Vercel Edge</text>
    </svg>
  )}

  {type === 'chatbot' && (
    <svg viewBox="0 0 360 130" class="w-full h-full max-w-[340px]" fill="none" aria-hidden="true">
      <!-- Admin Model Studio -->
      <rect x="10" y="26" width="88" height="78" rx="10" fill="var(--bg-card)" stroke="var(--border-subtle)" stroke-width="1.5" />
      <text x="54" y="50" text-anchor="middle" fill="var(--accent-secondary)" class="font-mono-code text-[9.5px] font-bold">ADMIN STUDIO</text>
      <text x="54" y="67" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[8.5px]">Intent Training</text>
      <text x="54" y="83" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Response Tuning</text>

      <path d="M98 65H130" stroke="var(--accent-primary)" stroke-width="1.5" stroke-dasharray="3 3" />

      <!-- Python Flask NLP Engine -->
      <rect x="130" y="18" width="102" height="94" rx="12" fill="var(--accent-surface)" stroke="var(--accent-primary)" stroke-width="1.75" />
      <text x="181" y="42" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[9.5px] font-bold">FLASK NLP API</text>
      <text x="181" y="61" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[9px]">ML Classifier</text>
      <text x="181" y="78" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">Multi-Tenant PaaS</text>
      <text x="181" y="95" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[8px]">Low-Latency REST</text>

      <path d="M232 65H264" stroke="var(--accent-secondary)" stroke-width="1.5" stroke-dasharray="3 3" />

      <!-- Embeddable Webchat -->
      <rect x="264" y="26" width="86" height="78" rx="10" fill="var(--bg-card)" stroke="var(--border-accent)" stroke-width="1.5" />
      <text x="307" y="50" text-anchor="middle" fill="var(--accent-primary)" class="font-mono-code text-[9.5px] font-bold">WEB WIDGET</text>
      <text x="307" y="67" text-anchor="middle" fill="var(--text-primary)" class="font-mono-code text-[8px]">1-Line JS Embed</text>
      <text x="307" y="83" text-anchor="middle" fill="var(--text-secondary)" class="font-mono-code text-[8px]">24/7 Automation</text>
    </svg>
  )}
</div>
